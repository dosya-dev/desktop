<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>dosya.dev</string>
    <key>CFBundleExecutable</key>
    <string>DosyaFileProvider</string>
    <!-- Stamped at build time. The Developer ID and Mac App Store builds use
         different identifiers because their APPS do: the app identifier the
         Developer ID build uses was uploaded to App Store Connect once and
         that record was deleted, which spends it for the store forever, so the
         store build's app carries a different one. An extension's identifier
         must start with its app's, so it follows. See scripts/afterPack.mjs. -->
    <key>CFBundleIdentifier</key>
    <string>__BUNDLE_ID__</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>DosyaFileProvider</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <!-- Every macOS app extension Xcode builds declares this, and so does every
         File Provider extension macOS itself ships. This bundle is assembled by
         a script instead of Xcode, so nothing added it for us. -->
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <!-- Both stamped from the app at build time; a nested bundle whose version
         never moves is confusing in diagnostics and in pluginkit. They are two
         different values on a store build: CFBundleVersion is the app's build
         version (one monotonic integer per upload), and App Store Connect
         rejects an app extension whose CFBundleVersion differs from its
         containing app's. -->
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD_VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionFileProviderDocumentGroup</key>
        <string>group.dev.dosya.desktop</string>
        <key>NSExtensionFileProviderSupportsEnumeration</key>
        <true/>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.fileprovider-nonui</string>
        <key>NSExtensionPrincipalClass</key>
        <string>DosyaFileProviderExtension</string>
    </dict>
</dict>
</plist>
