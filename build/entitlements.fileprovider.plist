<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- TEMPLATE. __TEAM_ID__ is substituted by scripts/build-file-provider.mjs
         at signing time. It is not $(AppIdentifierPrefix): that is an Xcode
         build variable, and `codesign --entitlements` performs no substitution
         at all, so the literal string would end up in the signature.

         The value must match Session.swift's accessGroupSuffix with the team
         prefix, or resolvedAccessGroup() finds nothing and the extension reads
         a different keychain item than the app writes. -->
    <!-- Required, not a hardening choice: extensionKit refuses to spawn an app
         extension without it (errorDomain code 16, "Extension must have
         com.apple.security.app-sandbox entitlement"), and Finder then shows
         only "dosya encountered an error". The containing app is NOT sandboxed
         and need not be. Everything the extension touches lives inside its
         container: the provider's temporaryDirectoryURL, its own Application
         Support, the group container, and the keychain group below. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Xcode signs these two into every bundle it provisions. App Store Connect
         refuses a TestFlight build whose bundle lacks them while its profile
         names them (ITMS-90886), and the extension is signed by our script,
         not Xcode, so nothing adds them for us. __BUNDLE_ID__ is the
         extension's identifier for the target being built. -->
    <key>com.apple.application-identifier</key>
    <string>__TEAM_ID__.__BUNDLE_ID__</string>
    <key>com.apple.developer.team-identifier</key>
    <string>__TEAM_ID__</string>
    <key>keychain-access-groups</key>
    <array>
        <string>__TEAM_ID__.group.dev.dosya.desktop</string>
    </array>
    <!-- The extension talks to the dosya.dev API itself. It is not a client of
         the app, which may not be running when Finder wakes it. -->
    <!-- The App Group the Info.plist's NSExtensionFileProviderDocumentGroup
         names. macOS will not register a File Provider extension without that
         key, and the key is only honoured for a group the extension is entitled
         to. The profile grants both "group.dev.dosya.desktop" and the
         team-wildcard form. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.dev.dosya.desktop</string>
    </array>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
